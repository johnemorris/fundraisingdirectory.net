---
import { legacyRoutes } from "../data/legacyRoutes";

export function getStaticPaths() {
  return legacyRoutes.map((route) => ({
    params: {
      legacy: route.path,
    },
    props: {
      route,
    },
  }));
}

const { route } = Astro.props;

const canonicalUrl =
  `https://fundraisingdirectory.net/${route.path}.html`;
const socialImage = "https://fundraisingdirectory.net/og.png";
const metaDescription = `${route.description} This section of FundraisingDirectory.net is currently being updated.`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />

  <title>{route.title} | FundraisingDirectory.net</title>

  <meta
    name="description"
    content={metaDescription}
  />

  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="FundraisingDirectory.net" />
  <meta property="og:title" content={`${route.title} | FundraisingDirectory.net`} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={socialImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${route.title} | FundraisingDirectory.net`} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={socialImage} />
</head>

<body>
  <header class="site-header">
    <a href="/" class="logo">
      <span class="logo-mark">◆</span>
      <span>
        Fundraising
        <strong>Directory</strong>
      </span>
    </a>

    <a href="/" class="header-home">Home</a>
  </header>

  <main>
    <section class="hero">
      <div class="hero-copy">
        <div class="update-label">
          <span>↻</span>
          We're updating the directory
        </div>

        <h1>{route.title}</h1>

        <p class="intro">
          {route.description}
        </p>
      </div>

      <div class="illustration" aria-hidden="true">
        <div class="blob blob-one"></div>
        <div class="blob blob-two"></div>

        <div class="plant">
          <div class="leaf leaf-1"></div>
          <div class="leaf leaf-2"></div>
          <div class="leaf leaf-3"></div>
          <div class="pot"></div>
        </div>

        <div class="browser">
          <div class="browser-top">
            <i></i><i></i><i></i>
          </div>

          <div class="browser-body">
            <div class="browser-image">
              <span>◆</span>
            </div>

            <div class="browser-lines">
              <i></i>
              <i></i>
              <i></i>
              <i></i>
            </div>
          </div>
        </div>

        <div class="idea">💡</div>
        <div class="cup"></div>
      </div>
    </section>

    <section class="modernizing">
      <div class="tool-icon">🛠</div>

      <div class="modernizing-copy">
        <h2>This section is being modernized.</h2>

        <p>
          FundraisingDirectory.net has returned, and we're rebuilding this
          section with current fundraising companies, resources, and
          information.
        </p>

        <p>
          In the meantime, visit the main directory to follow the rebuild and
          explore what's coming next.
        </p>
      </div>

      <div class="modernizing-action">
        <a href="/" class="primary-button">
          <span>→</span>
          Visit FundraisingDirectory.net
        </a>

        <a href="/" class="home-link">
          ⌂ &nbsp; Go to Homepage
        </a>
      </div>
    </section>

    <section class="history">
      <div class="info-icon">i</div>

      <div>
        <strong>
          You reached a page from the original FundraisingDirectory.net.
        </strong>

        <p>
          We've kept this address active while the directory is being rebuilt.
        </p>
      </div>

      <div class="heart">♡</div>
    </section>

    <section class="features">
      <article>
        <div class="feature-icon">⌕</div>
        <div>
          <h3>Find Fundraising Companies</h3>
          <p>
            Search our growing directory of fundraising programs.
          </p>
        </div>
      </article>

      <article>
        <div class="feature-icon">💡</div>
        <div>
          <h3>Discover Fundraising Ideas</h3>
          <p>
            Explore ideas for schools, nonprofits, teams, and more.
          </p>
        </div>
      </article>

      <article>
        <div class="feature-icon">▤</div>
        <div>
          <h3>Resources &amp; Guides</h3>
          <p>
            Helpful guides, articles, and fundraising best practices.
          </p>
        </div>
      </article>

      <article>
        <div class="feature-icon">♧</div>
        <div>
          <h3>Support Your Mission</h3>
          <p>
            Raise more. Stress less. Make an impact.
          </p>
        </div>
      </article>
    </section>
  </main>
</body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    color: #0c2852;
    background: #ffffff;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system,
      BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .site-header {
    min-height: 84px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px clamp(24px, 6vw, 80px);
    border-bottom: 1px solid #e7eeee;
    background: rgba(255,255,255,.96);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #0c2852;
    text-decoration: none;
    font-size: 1.35rem;
    font-weight: 800;
    line-height: .9;
  }

  .logo strong {
    display: block;
    color: #07955a;
  }

  .logo-mark {
    color: #07955a;
    font-size: 1.5rem;
  }

  .header-home {
    padding: 10px 18px;
    color: #087c4c;
    font-weight: 700;
    text-decoration: none;
  }

  main {
    width: min(1320px, calc(100% - 40px));
    margin: auto;
  }

  .hero {
    min-height: 415px;
    display: grid;
    grid-template-columns: .95fr 1.05fr;
    align-items: center;
    gap: 50px;
    padding: 50px 0 28px;
  }

  .update-label {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 14px;
    margin-bottom: 20px;
    border-radius: 10px;
    background: #eaf8f1;
    color: #07844e;
    font-size: .84rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    max-width: 650px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.2rem, 6vw, 5.6rem);
    line-height: .94;
    letter-spacing: -.045em;
    color: #092557;
  }

  .intro {
    max-width: 600px;
    margin: 28px 0 0;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.65;
  }

  .illustration {
    position: relative;
    min-height: 320px;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    background: #e5f7f3;
  }

  .blob-one {
    width: 340px;
    height: 340px;
    right: 60px;
    top: -15px;
  }

  .blob-two {
    width: 190px;
    height: 190px;
    left: 40px;
    bottom: 5px;
    background: #f0faf7;
  }

  .browser {
    position: absolute;
    z-index: 2;
    width: min(420px, 70%);
    height: 245px;
    right: 45px;
    top: 35px;
    border: 8px solid #087458;
    border-radius: 12px;
    background: white;
    box-shadow: 0 18px 35px rgba(17,79,62,.12);
  }

  .browser-top {
    height: 28px;
    display: flex;
    gap: 6px;
    align-items: center;
    padding: 0 10px;
    background: #087458;
  }

  .browser-top i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #b8e6d4;
  }

  .browser-body {
    display: grid;
    grid-template-columns: 42% 1fr;
    gap: 20px;
    padding: 30px;
  }

  .browser-image {
    height: 125px;
    display: grid;
    place-items: center;
    border-radius: 7px;
    background: linear-gradient(145deg,#c9eee1,#68b99b);
    color: #087458;
    font-size: 2.5rem;
  }

  .browser-lines {
    padding-top: 10px;
  }

  .browser-lines i {
    display: block;
    height: 7px;
    margin-bottom: 17px;
    border-radius: 10px;
    background: #d8dfdd;
  }

  .browser-lines i:first-child {
    width: 42%;
    background: #4caf88;
  }

  .plant {
    position: absolute;
    z-index: 3;
    left: 8%;
    bottom: 25px;
    width: 100px;
    height: 180px;
  }

  .pot {
    position: absolute;
    bottom: 0;
    left: 28px;
    width: 54px;
    height: 62px;
    border-radius: 7px 7px 24px 24px;
    background: #eadfc9;
  }

  .leaf {
    position: absolute;
    width: 34px;
    height: 90px;
    bottom: 50px;
    left: 40px;
    border-radius: 100% 0 100% 0;
    background: #159763;
    transform-origin: bottom;
  }

  .leaf-1 { transform: rotate(-35deg); }
  .leaf-2 { transform: rotate(15deg); height: 115px; }
  .leaf-3 { transform: rotate(45deg); }

  .idea {
    position: absolute;
    z-index: 4;
    right: 30px;
    top: 8px;
    width: 78px;
    height: 78px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #ffd56b;
    font-size: 2rem;
  }

  .cup {
    position: absolute;
    z-index: 4;
    right: 15px;
    bottom: 30px;
    width: 75px;
    height: 60px;
    border-radius: 5px 5px 28px 28px;
    background: #087458;
  }

  .modernizing {
    display: grid;
    grid-template-columns: auto 1fr minmax(300px, .7fr);
    gap: 28px;
    align-items: center;
    padding: 30px;
    border: 1px solid #f3d78e;
    border-radius: 18px;
    background: #fffaf0;
  }

  .tool-icon {
    width: 70px;
    height: 70px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #ffb515;
    font-size: 1.8rem;
  }

  .modernizing h2 {
    margin: 0 0 8px;
    font-size: 1.45rem;
  }

  .modernizing p {
    margin: 7px 0;
    color: #213755;
    line-height: 1.55;
  }

  .modernizing-action {
    padding-left: 28px;
    border-left: 1px solid #ead7aa;
    text-align: center;
  }

  .primary-button {
    display: block;
    padding: 17px 20px;
    border-radius: 9px;
    background: #069756;
    color: white;
    font-weight: 800;
    text-decoration: none;
  }

  .home-link {
    display: inline-block;
    margin-top: 17px;
    color: #07894f;
    font-weight: 750;
    text-decoration: none;
  }

  .history {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 20px;
    margin-top: 16px;
    padding: 20px 28px;
    border: 1px solid #cfe1fa;
    border-radius: 15px;
    background: #f1f7ff;
  }

  .history p {
    margin: 4px 0 0;
    color: #41516a;
  }

  .info-icon {
    width: 45px;
    height: 45px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #3679df;
    color: white;
    font-size: 1.4rem;
    font-family: Georgia, serif;
    font-weight: bold;
  }

  .heart {
    color: #069a82;
    font-size: 3rem;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 20px;
    margin: 16px 0 60px;
    padding: 25px;
    border: 1px solid #dcece4;
    border-radius: 16px;
    background: #f7fcf9;
  }

  .features article {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
  }

  .feature-icon {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 13px;
    background: #e5f6ed;
    color: #078b51;
    font-size: 1.6rem;
  }

  .features h3 {
    margin: 2px 0 7px;
    font-size: 1rem;
  }

  .features p {
    margin: 0;
    color: #4c5e70;
    font-size: .88rem;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 38px;
    }

    .illustration {
      min-height: 270px;
    }

    .modernizing {
      grid-template-columns: auto 1fr;
    }

    .modernizing-action {
      grid-column: 1 / -1;
      padding: 20px 0 0;
      border-left: 0;
      border-top: 1px solid #ead7aa;
    }

    .features {
      grid-template-columns: repeat(2,1fr);
    }
  }

  @media (max-width: 600px) {
    main {
      width: min(100% - 28px, 1320px);
    }

    .site-header {
      padding: 16px 18px;
    }

    h1 {
      font-size: clamp(2.8rem, 15vw, 4rem);
    }

    .illustration {
      min-height: 235px;
    }

    .browser {
      width: 78%;
      height: 195px;
      right: 5px;
    }

    .browser-body {
      padding: 20px;
    }

    .browser-image {
      height: 95px;
    }

    .plant {
      left: 0;
      transform: scale(.8);
      transform-origin: bottom left;
    }

    .modernizing {
      grid-template-columns: 1fr;
      padding: 24px;
    }

    .tool-icon {
      width: 55px;
      height: 55px;
    }

    .history {
      grid-template-columns: auto 1fr;
    }

    .heart {
      display: none;
    }

    .features {
      grid-template-columns: 1fr;
    }
  }
</style>
