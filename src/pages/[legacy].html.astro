---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import DiscoveryHero from "../components/DiscoveryHero.astro";
import { getLegacyDiscoveryContext } from "../data/discovery";
import { legacyRoutes } from "../data/legacyRoutes";
import { SITE_ROUTES } from "../data/site";
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/historical.css";

export function getStaticPaths() {
  return legacyRoutes.map((route) => ({ params: { legacy: route.path }, props: { route } }));
}

const { route } = Astro.props;
const context = getLegacyDiscoveryContext(route);
const canonicalPath = `/${route.path}.html`;
const isResourcesLanding = route.path === "Fundraising-Resources";
const isIdeasEditorial = (route.type === "resource" && !context.group) || route.type === "product";
const displayTitle = route.title;
const breadcrumbs = isResourcesLanding
  ? [{ label: "Home", href: "/" }, { label: "Fundraising Resources" }]
  : isIdeasEditorial
    ? [{ label: "Home", href: "/" }, { label: "Fundraising Ideas", href: SITE_ROUTES.ideas }, { label: route.title }]
    : [{ label: "Home", href: "/" }, { label: context.parentLabel, href: context.providerHref }, { label: route.title }];
const actions = [
  { label: `Find providers${context.group ? ` for ${context.parentLabel}` : ""}`, href: context.providerHref, primary: true },
  { label: "Explore fundraising ideas", href: SITE_ROUTES.ideas },
  { label: "Product fundraisers", href: SITE_ROUTES.productSales },
  { label: "Online fundraising", href: SITE_ROUTES.onlineFundraising },
  { label: "Fundraising guides", href: SITE_ROUTES.guides },
].filter((action, index, list) => action.href !== canonicalPath && list.findIndex((candidate) => candidate.href === action.href) === index);
const resourceDestinations = [
  {
    label: "Fundraising ideas",
    description: "Explore current fundraising approaches and paths organized around the kind of group you support.",
    href: SITE_ROUTES.ideas,
  },
  {
    label: "Provider research",
    description: "Compare source-backed provider profiles, programs, availability, and official links.",
    href: SITE_ROUTES.directory,
  },
];
---

<SiteLayout title={`${displayTitle} | FundraisingDirectory.net`} description={route.description} canonical={new URL(canonicalPath, SITE_ROUTES.origin).href}>
  <Breadcrumbs items={breadcrumbs} />

  {
    isResourcesLanding ? (
      <main class="historical-shell resources-shell">
        <DiscoveryHero
          eyebrow="Fundraising resources"
          title="A practical starting point for fundraising research."
          description="Use current idea paths, provider research tools, and planning prompts while the broader resource collection is developed."
          tone="navy"
          visualLabel="Research and plan"
          visualKey="resource"
          compact
        >
          <a class="button button-primary" href={SITE_ROUTES.ideas}>Explore fundraising ideas <span aria-hidden="true">→</span></a>
          <a class="button button-light" href={SITE_ROUTES.directory}>Research providers</a>
        </DiscoveryHero>

        <section class="resources-intro" aria-labelledby="resources-start-title">
          <div>
            <p class="eyebrow">Available now</p>
            <h2 id="resources-start-title">Useful places to begin</h2>
          </div>
          <p>This first resource collection is intentionally focused on destinations that are available today. Broader professional, grant, planning, and software resources will be evaluated separately.</p>
        </section>

        <nav class="resources-index" aria-label="Current fundraising resources">
          {resourceDestinations.map((resource) => (
            <a href={resource.href}>
              <span>
                <strong>{resource.label}</strong>
                <small>{resource.description}</small>
              </span>
              <i aria-hidden="true">→</i>
            </a>
          ))}
        </nav>

        <section class="resources-planning" aria-labelledby="planning-title">
          <div>
            <p class="eyebrow eyebrow-purple">Before choosing a program</p>
            <h2 id="planning-title">Build a shortlist around your real constraints.</h2>
          </div>
          <ul>
            <li>Clarify your fundraising goal, timeline, and available volunteers.</li>
            <li>Compare costs, fulfillment, payment handling, and organizer workload.</li>
            <li>Confirm current terms directly with a provider before beginning.</li>
          </ul>
        </section>

        <section class="historical-context resources-context">
          <div>
            <p class="eyebrow eyebrow-purple">Independent discovery</p>
            <h2>Research here, then work directly with the provider.</h2>
          </div>
          <p>FundraisingDirectory.net organizes information and links to outside resources. It does not administer campaigns, collect proceeds, or guarantee outcomes.</p>
          <a href={SITE_ROUTES.disclaimer}>Read the directory disclaimer <span aria-hidden="true">→</span></a>
        </section>
      </main>
    ) : (
      <main class="historical-shell">
        <DiscoveryHero eyebrow={context.parentLabel} title={displayTitle} description={route.description} tone={context.tone} visualLabel={displayTitle.replace(" Fundraising", "")} visualKey={context.visualKey} compact>
          <a class="button button-primary" href={context.providerHref}>Find matching providers <span aria-hidden="true">→</span></a>
          <a class="text-link" href={SITE_ROUTES.ideas}>Explore fundraising ideas</a>
        </DiscoveryHero>

        <section class="historical-intro" aria-labelledby="start-title">
          <div>
            <p class="eyebrow">Start exploring</p>
            <h2 id="start-title">Useful ways to move forward</h2>
          </div>
          <p>Compare current provider records, browse established fundraising approaches, and use the available guides to plan questions before choosing a program.</p>
        </section>

        <nav class="historical-actions" aria-label={`${route.title} discovery options`}>
          {actions.map((action, index) => (
            <a class:list={[{ "historical-action-primary": action.primary }]} href={action.href}>
              <span>0{index + 1}</span>
              <strong>{action.label}</strong>
              <i aria-hidden="true">↗</i>
            </a>
          ))}
        </nav>

        <section class="historical-context">
          <div>
            <p class="eyebrow eyebrow-purple">Independent discovery</p>
            <h2>Research the fit, then work directly with the provider.</h2>
          </div>
          <p>FundraisingDirectory.net organizes information and links to provider websites. It does not administer campaigns, collect proceeds, or guarantee results.</p>
          <a href={SITE_ROUTES.disclaimer}>Read the directory disclaimer <span aria-hidden="true">→</span></a>
        </section>
      </main>
    )
  }
</SiteLayout>
