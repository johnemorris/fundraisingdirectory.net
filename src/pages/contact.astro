---
import InformationPage from "../components/InformationPage.astro";
import { SITE_CONTACT_EMAIL, SITE_ROUTES } from "../data/site";
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/information.css";

const contactHref = `mailto:${SITE_CONTACT_EMAIL}`;
---

<SiteLayout
  title="Contact | FundraisingDirectory.net"
  description="Contact FundraisingDirectory.net with general questions, listing inquiries, corrections, resource suggestions, and website feedback."
>
  <InformationPage
    eyebrow=""
    breadcrumbLabel="Contact"
    title="Get in touch with us."
    intro="Questions about the site, a listing, or a factual correction are always welcome. We’re an independent fundraising information and discovery site and don’t operate fundraising campaigns or process donations."
  >
    <section>
      <h2>Contact us for</h2>
      <div>
        <a class="information-email" href={contactHref}>
          {SITE_CONTACT_EMAIL}
        </a>

        <ul class="information-list">
          <li>
            <b>General questions & feedback</b> — Questions about the site or
            suggestions for improving it.
          </li>
          <li>
            <b>Corrections</b> — Let us know about outdated pricing, broken
            links, changed program details, or other factual errors.
          </li>
          <li>
            <b>Providers</b> — Suggest a provider, request an update to an
            existing listing, or contact us about your provider profile.
          </li>
        </ul>
      </div>
    </section>

    <section>
      <h2>Campaign and order support</h2>
      <div>
        <p>
          Need help with a fundraiser, donation, order, payment, or a provider's
          service? Please contact the fundraising provider directly. We don't
          operate campaigns, process transactions, or provide customer support
          for listed companies.
        </p>
        <a class="information-link" href={SITE_ROUTES.directory}>
          Find the provider →
        </a>
      </div>
    </section>

    <section>
      <h2>Provider information</h2>
      <div>
        <p>
          Are you listed in the directory? You can contact us about incorrect
          or outdated information using the email address above. New listing
          submissions and profile claims are not currently open.
        </p>
        <a class="information-link" href={SITE_ROUTES.forProviders}>
          Read provider information →
        </a>
      </div>
    </section>
  </InformationPage>
</SiteLayout>