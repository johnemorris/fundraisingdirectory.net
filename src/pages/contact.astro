---
import InformationPage from "../components/InformationPage.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/information.css";
---

<SiteLayout
  title="Contact | FundraisingDirectory.net"
  description="Contact information and current provider-submission status for FundraisingDirectory.net."
>
  <InformationPage
    eyebrow="Contact"
    breadcrumbLabel="Contact"
    title="Contact the directory."
    intro="FundraisingDirectory.net does not currently have a monitored public email address or contact form. Contact details will appear here when a reliable channel is ready."
  >
    <section class="information-notice">
      <h2>Public contact is not yet available</h2>
      <p>
        We will publish contact details here only after a monitored channel is
        ready. Until then, visitors cannot send general inquiries through this
        site, and provider submissions remain closed.
      </p>
    </section>

    <section>
      <h2>Fundraising provider inquiries</h2>
      <div>
        <p>
          Provider onboarding, listing submissions, and profile claims are not
          currently open. The provider information page explains the current
          status without collecting submissions.
        </p>
        <a class="information-link" href="/for-providers/">Read provider information →</a>
      </div>
    </section>

    <section>
      <h2>Looking for a fundraising provider?</h2>
      <p>
        The provider directory is available now and includes links to each
        provider's official website for program-specific questions.
      </p>
      <a class="information-link" href="/providers/">Browse the provider directory →</a>
    </section>
  </InformationPage>
</SiteLayout>
