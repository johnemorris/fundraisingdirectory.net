---
import InformationPage from "../components/InformationPage.astro";
import { SITE_CONTACT_EMAIL, SITE_ROUTES } from "../data/site";
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/information.css";

const contactHref = `mailto:${SITE_CONTACT_EMAIL}`;
---

<SiteLayout
  title="Contact | FundraisingDirectory.net"
  description="Contact FundraisingDirectory.net with general questions, listing inquiries, corrections, resource suggestions, and website feedback."
>
  <InformationPage
    eyebrow="Contact"
    breadcrumbLabel="Contact"
    title="Contact the directory."
    intro="Questions about the directory, a listing, or a factual correction are welcome. FundraisingDirectory.net is an independent information and discovery site."
  >
    <section class="information-notice">
      <div>
        <h2>Email the directory</h2>
        <p>Use this address for questions and feedback about FundraisingDirectory.net.</p>
        <a class="information-email" href={contactHref}>{SITE_CONTACT_EMAIL}</a>
      </div>
    </section>

    <section>
      <h2>Reasons to contact us</h2>
      <div>
        <ul class="information-list">
          <li>Ask a general question about FundraisingDirectory.net</li>
          <li>Suggest a correction or report a factual issue</li>
          <li>Send a provider or listing-related inquiry</li>
          <li>Suggest a fundraising resource</li>
          <li>Share website feedback</li>
        </ul>
      </div>
    </section>

    <section>
      <h2>Campaign and order support</h2>
      <div>
        <p>
          Questions about an active fundraiser, donation, order, payment, or a
          provider's service should be directed to that fundraising provider.
          FundraisingDirectory.net does not operate campaigns, process
          transactions, or provide customer support on behalf of listed companies.
        </p>
        <a class="information-link" href={SITE_ROUTES.directory}>Find a provider's profile →</a>
      </div>
    </section>

    <section>
      <h2>Provider information</h2>
      <div>
        <p>
          Provider onboarding, listing submissions, and profile claims are not
          currently open. Listing-related questions may use the email address above.
        </p>
        <a class="information-link" href={SITE_ROUTES.forProviders}>Read provider information →</a>
      </div>
    </section>
  </InformationPage>
</SiteLayout>
