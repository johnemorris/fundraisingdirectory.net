---
import InformationPage from "../components/InformationPage.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/information.css";
---

<SiteLayout
  title="Directory Disclaimer | FundraisingDirectory.net"
  description="Understand the independent role, listing practices, and limitations of FundraisingDirectory.net."
>
  <InformationPage
    eyebrow="Directory disclaimer"
    title="Independent information—not a fundraising intermediary."
    intro="FundraisingDirectory.net helps visitors discover and research fundraising options. It does not participate in transactions between users and listed providers."
  >
    <section>
      <h2>Our role</h2>
      <p>
        FundraisingDirectory.net does not broker or negotiate fundraising
        transactions, administer campaigns, collect proceeds or donations on
        behalf of listed organizations, or handle payments between visitors and
        providers.
      </p>
    </section>

    <section>
      <h2>Listings are not guarantees</h2>
      <p>
        A company or program appearing in the directory is not automatically
        affiliated with, endorsed by, sponsored by, or guaranteed by
        FundraisingDirectory.net. We do not guarantee a provider's performance,
        current availability, terms, or fundraising results. Visitors are
        responsible for evaluating providers and conducting their own
        transactions.
      </p>
    </section>

    <section>
      <h2>Placement and compensation</h2>
      <p>
        Organic listings, featured editorial placement, sponsored placement,
        partnerships, and affiliate relationships are separate concepts. Any
        sponsored or compensated relationship will be disclosed where it applies.
        Payment for visibility does not purchase an undisclosed endorsement.
      </p>
    </section>

    <section>
      <h2>Confirm current details</h2>
      <p>
        Provider programs, pricing, eligibility, shipping, availability, and
        terms can change. Confirm important details directly with the provider
        before beginning a fundraiser or sharing personal or payment information.
      </p>
    </section>
  </InformationPage>
</SiteLayout>
