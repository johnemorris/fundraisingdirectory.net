---
const homeUrl = "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Page Not Found | FundraisingDirectory.net</title>

    <meta
      name="description"
      content="The page you're looking for could not be found. FundraisingDirectory.net is currently being rebuilt and modernized."
    />

    <meta name="robots" content="noindex, follow" />
  </head>

  <body>
    <main class="not-found-page">
      <section class="content">
        <a href={homeUrl} class="brand">FundraisingDirectory.net</a>

        <p class="eyebrow">404 — Page Not Found</p>

        <h1>This page isn't here.</h1>

        <p class="description">
          FundraisingDirectory.net has returned and is currently being rebuilt.
          If you followed an older link, that page may not have been restored yet.
        </p>

        <div class="notice">
          <h2>Looking for fundraising information?</h2>

          <p>
            We're modernizing the directory with fundraising companies,
            resources, ideas, and tools.
          </p>
        </div>

        <a href={homeUrl} class="home-button">
          ← Back to FundraisingDirectory.net
        </a>

        <p class="history">
          Older FundraisingDirectory.net links are being reviewed and restored
          where they are still useful.
        </p>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    background: #f7f8f6;
    color: #18231d;
  }

  .not-found-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 48px 22px;
  }

  .content {
    width: min(720px, 100%);
  }

  .brand {
    display: inline-block;
    margin-bottom: 60px;
    color: inherit;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
  }

  .eyebrow {
    margin: 0 0 12px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.8rem, 8vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .description {
    max-width: 650px;
    margin: 28px 0 36px;
    font-size: 1.18rem;
    line-height: 1.7;
  }

  .notice {
    padding: 28px 0;
    border-top: 1px solid #ccd2cd;
    border-bottom: 1px solid #ccd2cd;
  }

  .notice h2 {
    margin: 0 0 12px;
    font-size: 1.35rem;
  }

  .notice p {
    margin: 0;
    line-height: 1.65;
  }

  .home-button {
    display: inline-block;
    margin-top: 32px;
    padding: 14px 22px;
    border-radius: 999px;
    background: #18231d;
    color: white;
    font-weight: 700;
    text-decoration: none;
  }

  .home-button:hover {
    opacity: 0.88;
  }

  .history {
    margin-top: 36px;
    font-size: 0.86rem;
    line-height: 1.6;
    opacity: 0.65;
  }
</style>
