---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import DiscoveryHero from "../components/DiscoveryHero.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Page Not Found | FundraisingDirectory.net"
  description="The requested page could not be found. Explore current fundraising providers, ideas, and group-specific discovery paths."
  noindex
>
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Page not found" }]} />

  <main class="not-found-shell">
    <DiscoveryHero
      eyebrow="404 — Page Not Found"
      title="We couldn't find that fundraiser."
      description="The page may have moved, the address may be incorrect, or the resource may no longer be available."
      tone="purple"
      visualLabel="Find another fundraising path"
      visualKey="general"
      compact
    >
      <a class="button button-primary" href="/providers/">Browse Fundraising Providers <span aria-hidden="true">→</span></a>
      <a class="button button-light" href="/ideas/">Explore Fundraising Ideas</a>
      <a class="text-link" href="/">Return home</a>
    </DiscoveryHero>
  </main>
</SiteLayout>

<style>
  .not-found-shell { width: min(var(--interior-shell), calc(100% - var(--interior-gutter) - var(--interior-gutter))); margin: 0 auto; padding-bottom: 86px; }
</style>
