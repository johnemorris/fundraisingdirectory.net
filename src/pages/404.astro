---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import DiscoveryHero from "../components/DiscoveryHero.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Page Not Found | FundraisingDirectory.net"
  description="The requested page could not be found. Explore current fundraising providers, ideas, and group-specific discovery paths."
  noindex
>
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Page not found" }]} />

  <main class="not-found-shell">
    <DiscoveryHero
      eyebrow="404 — Page not found"
      title="This page isn't here."
      description="The address may be outdated or incomplete. Use one of these current discovery paths to keep exploring."
      tone="purple"
      visualLabel="Choose a new path"
      visualKey="general"
      compact
    >
      <a class="button button-primary" href="/providers/">Browse providers <span aria-hidden="true">→</span></a>
      <a class="text-link" href="/">Return home</a>
    </DiscoveryHero>

    <nav class="not-found-paths" aria-label="Useful discovery paths">
      <a href="/providers/?group=schools"><span>01</span><strong>Fundraising for schools</strong><i aria-hidden="true">↗</i></a>
      <a href="/providers/?group=sports-athletics"><span>02</span><strong>Fundraising for sports teams</strong><i aria-hidden="true">↗</i></a>
      <a href="/Church-Fundraising.html"><span>03</span><strong>Fundraising for churches</strong><i aria-hidden="true">↗</i></a>
      <a href="/Fundraising-Resources.html"><span>04</span><strong>Explore fundraising ideas</strong><i aria-hidden="true">↗</i></a>
    </nav>
  </main>
</SiteLayout>

<style>
  .not-found-shell { width: min(var(--interior-shell), calc(100% - var(--interior-gutter) - var(--interior-gutter))); margin: 0 auto; padding-bottom: 86px; }
  .not-found-paths { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); border-block: 1px solid rgba(18,48,74,.16); }
  .not-found-paths a { min-height: 150px; display: grid; grid-template-columns: 1fr auto; align-content: space-between; gap: 14px; padding: 24px; border-right: 1px solid rgba(18,48,74,.16); color: var(--ink); text-decoration: none; }
  .not-found-paths a:last-child { border-right: 0; }
  .not-found-paths a:hover { background: var(--surface-cool); }
  .not-found-paths span { color: var(--teal); font-size: .72rem; font-weight: 900; }
  .not-found-paths strong { grid-column: 1 / -1; font-size: 1rem; line-height: 1.35; }
  .not-found-paths i { justify-self: end; font-style: normal; }
  @media (max-width: 780px) {
    .not-found-paths { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .not-found-paths a { border-bottom: 1px solid rgba(18,48,74,.16); }
  }
  @media (max-width: 480px) {
    .not-found-paths { grid-template-columns: 1fr; }
    .not-found-paths a { min-height: 112px; border-right: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .not-found-paths a { transition: none; } }
</style>
