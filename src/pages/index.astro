---
import "../styles/index.css";

const pageTitle = "FundraisingDirectory.net — Find Better Ways to Fundraise";
const pageDescription =
  "FundraisingDirectory.net is being rebuilt as a modern directory of fundraising companies, ideas, programs, resources, and opportunities for schools, teams, churches, nonprofits, clubs, and community organizations.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <link rel="canonical" href="https://fundraisingdirectory.net/" />

    <meta name="robots" content="index, follow" />

    <meta name="theme-color" content="#edf5ef" />
  </head>

  <body>
    <main class="page-shell">
      <div class="background-shape shape-one" aria-hidden="true"></div>
      <div class="background-shape shape-two" aria-hidden="true"></div>
      <div class="background-shape shape-three" aria-hidden="true"></div>

      <section class="hero">
        <div class="hero-content">
          <div class="status">
            <span class="status-dot" aria-hidden="true"></span>
            The directory is coming back
          </div>

          <p class="eyebrow">FundraisingDirectory.net</p>

          <h1>
            Finding the right fundraiser
            <span>should be easier.</span>
          </h1>

          <p class="intro">
            We're rebuilding FundraisingDirectory.net into a modern place to
            discover fundraising companies, ideas, programs, resources, and
            new ways to raise money for your organization.
          </p>

          <div class="coming-soon">
            <div>
              <strong>We're bringing the directory back.</strong>

              <span>
                The original FundraisingDirectory.net is being rebuilt and
                modernized for today's fundraising landscape.
              </span>
            </div>

            <div class="construction-mark" aria-hidden="true">
              FD
            </div>
          </div>
        </div>

        <div class="directory-preview" aria-hidden="true">
          <div class="preview-header">
            <div class="preview-search">
              <span class="search-icon"></span>
              <span>Search fundraising options...</span>
            </div>
          </div>

          <div class="preview-body">
            <div class="preview-card company-card">
              <div class="preview-icon">
                <span>01</span>
              </div>

              <div class="preview-copy">
                <strong>Fundraising Companies</strong>
                <span>Find programs, providers & services</span>
              </div>

              <span class="preview-arrow">→</span>
            </div>

            <div class="preview-card ideas-card">
              <div class="preview-icon">
                <span>02</span>
              </div>

              <div class="preview-copy">
                <strong>Fundraising Ideas</strong>
                <span>Events, challenges, DIY ideas & more</span>
              </div>

              <span class="preview-arrow">→</span>
            </div>

            <div class="preview-card organization-card">
              <div class="preview-icon">
                <span>03</span>
              </div>

              <div class="preview-copy">
                <strong>Fundraising by Organization</strong>
                <span>Schools, teams, churches & nonprofits</span>
              </div>

              <span class="preview-arrow">→</span>
            </div>

            <div class="preview-card trends-card">
              <div class="preview-icon">
                <span>04</span>
              </div>

              <div class="preview-copy">
                <strong>What's New in Fundraising</strong>
                <span>New approaches, tools & trends</span>
              </div>

              <span class="preview-arrow">→</span>
            </div>
          </div>

          <div class="preview-note">
            <strong>Old favorites. New possibilities.</strong>
            <span>
              Classic fundraisers plus modern ways to raise money.
            </span>
          </div>

          <div class="tape tape-one"></div>
          <div class="tape tape-two"></div>
        </div>
      </section>

      <footer>
        <span>FundraisingDirectory.net</span>
        <span class="footer-divider"></span>
        <span>Rebuilding for 2026</span>
      </footer>
    </main>
  </body>
</html>
