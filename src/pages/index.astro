---
import { getCollection } from "astro:content";
import FeaturedFundraisers from "../components/home/FeaturedFundraisers.astro";
import FundraiserFinder from "../components/home/FundraiserFinder.astro";
import HowItWorks from "../components/home/HowItWorks.astro";
import GroupDiscovery from "../components/home/GroupDiscovery.astro";
import Guides from "../components/home/Guides.astro";
import PopularMethods from "../components/home/PopularMethods.astro";
import { fundraisingIdeas } from "../data/homepage";
import { SITE_ROUTES } from "../data/site";
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/index.css";

const providers = (await getCollection("providers"))
  .filter(
    (provider) =>
      !provider.data.meta.deleted && provider.data.status.lifecycle === "active",
  )
  .sort((a, b) => a.data.identity.name.localeCompare(b.data.identity.name));

const featuredProvider =
  providers.find((provider) => provider.data.identity.slug === "fundraising-com") ??
  providers[0];
const pageTitle =
  "FundraisingDirectory.net | Find Fundraising Ideas & Providers";
const pageDescription =
  "Discover fundraising ideas, programs, and providers for schools, teams, churches, nonprofits, clubs, and community groups.";
---

<SiteLayout
  title={pageTitle}
  description={pageDescription}
  noindex={false}
  canonical="https://fundraisingdirectory.net/"
  bodyClass="homepage"
>
  <main>
    <FundraiserFinder />
    <HowItWorks />
    <PopularMethods />
    {featuredProvider && <FeaturedFundraisers provider={featuredProvider} />}
    <GroupDiscovery />

    <section class="ideas-section" aria-labelledby="ideas-title">
      <div class="ideas-shape ideas-shape-one" aria-hidden="true"></div>
      <div class="ideas-shape ideas-shape-two" aria-hidden="true"></div>
      <div class="shell-wide ideas-layout">
        <div class="ideas-copy">
          <p class="eyebrow eyebrow-light">Think beyond the catalog</p>
          <h2 id="ideas-title">You don't have to sell cookie dough.</h2>
          <p>
            There are many ways to raise money. Explore approaches that fit
            your time, audience, and appetite for hands-on work.
          </p>
          <a class="button button-light" href={SITE_ROUTES.ideas}>
            Explore Fundraising Ideas <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="idea-list">
          {
            fundraisingIdeas.map((idea) => (
              <li>
                <strong>{idea}</strong>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="finder-reentry" aria-labelledby="reentry-title">
      <div class="shell-wide reentry-inner">
        <div>
          <p class="eyebrow">A simpler next step</p>
          <h2 id="reentry-title">Still not sure where to start?</h2>
          <p>
            Tell us about your group and narrow the options in two quick
            questions.
          </p>
        </div>
        <a class="button button-primary button-large" href="#finder">
          Help Me Find a Fundraiser <span aria-hidden="true">↑</span>
        </a>
      </div>
    </section>

    <Guides />

    <section
      class="provider-cta-section"
      id="provider-cta"
      aria-labelledby="provider-cta-title"
    >
      <div class="shell-wide provider-cta-inner">
        <div class="provider-cta-mark" aria-hidden="true">
          <span>F</span><span>D</span>
        </div>
        <div class="provider-cta-copy">
          <p class="eyebrow eyebrow-light">For fundraising providers</p>
          <h2 id="provider-cta-title">Offer a fundraising program?</h2>
          <p>
            Help schools, teams, nonprofits, and community organizations
            discover what you offer.
          </p>
        </div>
        <div class="provider-cta-actions">
          <span class="button button-light button-unavailable" aria-disabled="true">
            Submit Your Company <span>Coming soon</span>
          </span>
          <a href={SITE_ROUTES.directory}>
            Browse Current Listings <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
