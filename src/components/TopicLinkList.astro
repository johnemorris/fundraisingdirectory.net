---
export interface TopicLink {
  title: string;
  href: string;
  description?: string;
  label?: string;
  datedWindow?: {
    start_date: string;
    end_date: string;
  };
}
interface Props { links: TopicLink[] }
const { links } = Astro.props;
---
<ul class="topic-links">
  {links.map((link) => (
    <li data-dated-terms={link.datedWindow ? "" : undefined} data-start-date={link.datedWindow?.start_date} data-end-date={link.datedWindow?.end_date}><a href={link.href}>
      {link.label && <small>{link.label}</small>}
      <strong>{link.title} <span aria-hidden="true">→</span></strong>
      {link.description && <span>{link.description}</span>}
      {link.datedWindow && <span class="dated-window-status" data-date-status>Dated offer — valid only within the stated dates; verify current terms with the provider.</span>}
    </a></li>
  ))}
</ul>
<style lang="scss">
  .topic-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 30px;
    margin: 0;
    padding: 0;
    list-style: none;
    li { display: flex; min-width: 0; }
    a {
      display: grid;
      align-content: start;
      gap: 10px;
      width: 100%;
      padding: 24px 4px;
      border-top: 1px solid var(--border);
      color: var(--ink);
      text-decoration: none;
      &:hover strong { color: var(--teal-dark); text-decoration: underline; text-underline-offset: 4px; }
      > span { color: var(--text-muted); font-size: .9rem; line-height: 1.7; }
      > .dated-window-status {
        display: inline-flex;
        width: fit-content;
        padding: 0.25rem 0.625rem;
        border-left: 0.2rem solid var(--teal);
        border-radius: 0.375rem;
        background: var(--surface-alternate);
        color: var(--ink);
        font-size: 0.78rem;
        font-weight: 650;
        line-height: 1.4;
      }
    }
    li[data-dated-status="expired"] a > .dated-window-status {
      border-left-color: var(--border-strong);
      color: var(--text-muted);
    }
    strong { font-size: 1.1rem; line-height: 1.4; span { color: var(--teal); } }
    small { color: var(--purple-dark); font-weight: 650; }
  }
  @media (max-width: 680px) { .topic-links { grid-template-columns: 1fr; } }
</style>
