---
export interface TopicLink {
  title: string;
  href: string;
  description?: string;
  label?: string;
}
interface Props { links: TopicLink[] }
const { links } = Astro.props;
---
<ul class="topic-links">
  {links.map((link) => (
    <li><a href={link.href}>
      {link.label && <small>{link.label}</small>}
      <strong>{link.title} <span aria-hidden="true">→</span></strong>
      {link.description && <span>{link.description}</span>}
    </a></li>
  ))}
</ul>
<style lang="scss">
  .topic-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 30px;
    margin: 0;
    padding: 0;
    list-style: none;
    li { display: flex; min-width: 0; }
    a {
      display: grid;
      align-content: start;
      gap: 10px;
      width: 100%;
      padding: 24px 4px;
      border-top: 1px solid var(--border);
      color: var(--ink);
      text-decoration: none;
      &:hover strong { color: var(--teal-dark); text-decoration: underline; text-underline-offset: 4px; }
      > span { color: var(--text-muted); font-size: .9rem; line-height: 1.7; }
    }
    strong { font-size: 1.1rem; line-height: 1.4; span { color: var(--teal); } }
    small { color: var(--purple-dark); font-weight: 650; }
  }
  @media (max-width: 680px) { .topic-links { grid-template-columns: 1fr; } }
</style>
