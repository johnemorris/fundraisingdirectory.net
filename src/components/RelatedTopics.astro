---
interface Props { title?: string; items: Array<{ title: string; href: string }> }
const { title = "Related fundraising ideas", items } = Astro.props;
---
<nav class="related-topics" aria-label={title}>
  <h2>{title}</h2>
  <ul>{items.map((item) => <li><a href={item.href}>{item.title}</a></li>)}</ul>
</nav>
<style lang="scss">
  .related-topics {
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
    h2 { margin: 0 0 16px; color: var(--ink); font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.2; letter-spacing: -.025em; }
    ul { display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 0; padding: 0; list-style: none; }
    a { display: inline-flex; align-items: center; min-height: 44px; color: var(--teal-dark); text-underline-offset: 4px; }
  }
</style>
