---
import { SITE_ROUTES } from "../data/site";
import TopicLinkList from "./TopicLinkList.astro";
interface Props { path: string; title: string; providerHref: string; groupLabel: string }
const { path, title, providerHref, groupLabel } = Astro.props;
const details: Record<string, { description: string; links: Array<{ title: string; href: string; description?: string }> }> = {
  Cookbooks: {
    description: "We have not yet researched a cookbook fundraising publisher. This page does not currently offer a matched supplier list. A full guide needs to address recipe collection, permissions, editing, printing, ordering, and distribution.",
    links: [{ title: "Compare other fundraising ideas", href: SITE_ROUTES.ideas }, { title: "Browse the general provider directory", href: SITE_ROUTES.directory, description: "General fundraising options; these are not verified cookbook publishers." }],
  },
  "Fundraising-Software": {
    description: "This software guide is in progress. Start with the job you need a tool to do, then compare recorded features, eligibility, and terms. The links below cover different software purposes rather than treating every tool as a crowdfunding platform.",
    links: [{ title: "Donation platforms", href: "/providers/?product=donation-platform" }, { title: "Event fundraising platforms", href: "/providers/?product=event-fundraising-platform" }, { title: "Grant research tools", href: "/providers/?method=grant-seeking" }],
  },
  "Capital-Campaigns": {
    description: "A full guide to major-project fundraising is still being researched. Campaign scope, leadership, feasibility, and organizational requirements need a dedicated plan. The consulting profile below is a research starting point, not a guarantee of campaign suitability or results.",
    links: [{ title: "Review a nonprofit fundraising consulting profile", href: "/providers/graham-pelton/", description: "Graham-Pelton's record describes custom consulting for nonprofit institutions. Confirm the scope directly." }, { title: "Explore fundraising resources", href: SITE_ROUTES.resources }],
  },
  Fruit: {
    description: "We have not yet researched a fruit-specific fundraising supplier. A useful guide needs current product availability, delivery areas, ordering deadlines, handling instructions, and a plan for perishable orders. General product-sale records do not establish a fruit-program match.",
    links: [{ title: "Compare other product fundraising approaches", href: SITE_ROUTES.ideas + "#category-4" }, { title: "Browse all providers", href: SITE_ROUTES.directory, description: "Broader alternatives while fruit-specific research is incomplete." }],
  },
  "Bottled-Water": {
    description: "We have not yet researched a bottled-water fundraising supplier. Product sourcing, venue permissions, transport, storage, and unsold stock need further research before this page can offer a practical program comparison.",
    links: [{ title: "Explore other fundraising ideas", href: SITE_ROUTES.ideas }, { title: "Browse all providers", href: SITE_ROUTES.directory, description: "General alternatives, not a list of verified bottled-water suppliers." }],
  },
  "Eco-Friendly": {
    description: "This guide is in progress. Collection and reuse programs are one approach to research alongside product sales. Provider records describe what is collected and how proceeds work; environmental benefits need specific supporting evidence.",
    links: [{ title: "Explore collection and reuse programs", href: "/providers/?method=collection-reuse-fundraising" }, { title: "Compare other fundraising approaches", href: SITE_ROUTES.ideas }],
  },
};
const detail = details[path] ?? {
  description: `Our ${title.toLowerCase()} planning guide is still being developed. The links below lead to broader provider records and existing guides. They do not establish a program's suitability for your specific group or product; confirm that fit before choosing.`,
  links: [{ title: `Browse providers: ${groupLabel}`, href: providerHref }, { title: "Read available planning guides", href: SITE_ROUTES.guides }],
};
---
<section class="topic-placeholder" aria-labelledby="topic-status-title" data-topic-placeholder>
  <p class="eyebrow">Planning guide in progress</p>
  <h2 id="topic-status-title">This topic is still being researched.</h2>
  <p>{detail.description}</p>
  <TopicLinkList links={detail.links} />
  <a class="all-ideas" href={SITE_ROUTES.ideas}>Browse all fundraising ideas by category →</a>
</section>
<style lang="scss">
  .topic-placeholder {
    margin-top: 32px;
    padding: clamp(24px, 4vw, 40px);
    border: 1px solid var(--border);
    border-radius: 24px;
    background: var(--surface-elevated);
    h2 { margin: 8px 0 18px; color: var(--ink); font-size: clamp(1.6rem, 3vw, 2.4rem); line-height: 1.15; }
    > p:not(.eyebrow) { max-width: 74ch; margin-bottom: 24px; color: var(--text-muted); line-height: 1.8; }
    .all-ideas { display: inline-flex; align-items: center; min-height: 44px; margin-top: 18px; color: var(--teal-dark); text-underline-offset: 4px; }
  }
</style>
