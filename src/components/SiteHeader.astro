---
import Brand from "./Brand.astro";
import { getLegacyDiscoveryContext } from "../data/discovery";
import { legacyRoutes } from "../data/legacyRoutes";
import {
  PRIMARY_NAVIGATION,
  PROVIDER_METHOD_NAVIGATION,
  PROVIDER_ORGANIZATION_NAVIGATION,
  SITE_ROUTES,
} from "../data/site";

const currentPath = Astro.url.pathname;
const currentGroup = Astro.url.searchParams.get("group");
const currentMethods = Astro.url.searchParams.getAll("method");
const currentOrganization = PROVIDER_ORGANIZATION_NAVIGATION.find((item) => item.group === currentGroup);
const currentMethod = PROVIDER_METHOD_NAVIGATION.find((item) => currentMethods.includes(item.method));
const legacyRoute = legacyRoutes.find((route) => `/${route.path}.html` === currentPath);
const legacyContext = legacyRoute ? getLegacyDiscoveryContext(legacyRoute) : null;
const legacyOrganization = PROVIDER_ORGANIZATION_NAVIGATION.find((item) => item.group === legacyContext?.group);
const currentProviderChildKey = currentOrganization?.key ?? (!currentGroup ? currentMethod?.key : undefined) ?? legacyOrganization?.key;
const isProviderSection = currentPath.startsWith(SITE_ROUTES.directory) || Boolean(legacyContext?.group);
const exactPrimary = PRIMARY_NAVIGATION.find((item) => item.href === currentPath);
const currentTopKey = isProviderSection
  ? "providers"
  : exactPrimary?.key
    ? exactPrimary.key
  : legacyRoute && (legacyRoute.type === "resource" || legacyRoute.type === "product")
    ? "ideas"
    : undefined;
const providerParentIsPage = currentTopKey === "providers" && !currentProviderChildKey;
---

<header class="site-header" data-site-header>
  <div class="site-header-main shell-wide">
    <Brand />

    <nav class="desktop-primary-nav" aria-label="Primary navigation">
      <div class:list={["provider-menu", { "is-current-section": currentTopKey === "providers" }]} data-provider-menu>
        <div class="provider-menu-parent">
          <a class="site-nav-link provider-parent-link" href={SITE_ROUTES.directory} aria-current={providerParentIsPage ? "page" : undefined} aria-label={currentTopKey === "providers" && !providerParentIsPage ? "Fundraising Providers, current section" : undefined}>Fundraising Providers</a>
          <button class="provider-menu-toggle" type="button" aria-expanded="false" aria-controls="provider-discovery-menu" aria-label="Open Fundraising Providers menu" data-provider-menu-toggle><span aria-hidden="true">⌄</span></button>
        </div>

        <div class="provider-menu-panel" id="provider-discovery-menu" data-provider-menu-panel hidden>
          <div class="provider-menu-group provider-menu-view-all">
            <p>View all</p>
            <a href={SITE_ROUTES.directory}><span>All Fundraising Providers</span><span aria-hidden="true">→</span></a>
          </div>
          <div class="provider-menu-columns">
            <div class="provider-menu-group">
              <p>By organization</p>
              {PROVIDER_ORGANIZATION_NAVIGATION.map((item) => (
                <a href={item.href} aria-current={item.key === currentProviderChildKey ? "page" : undefined} data-provider-child={item.key} data-nav-group={item.group}>{item.label}</a>
              ))}
            </div>
            <div class="provider-menu-group">
              <p>By fundraising method</p>
              {PROVIDER_METHOD_NAVIGATION.map((item) => (
                <a href={item.href} aria-current={item.key === currentProviderChildKey ? "page" : undefined} data-provider-child={item.key} data-nav-method={item.method}>{item.label}</a>
              ))}
            </div>
          </div>
          <a class="provider-menu-all-link" href={SITE_ROUTES.directory}>View all fundraising providers <span aria-hidden="true">→</span></a>
        </div>
      </div>

      {PRIMARY_NAVIGATION.map((item) => (
        <a class="site-nav-link" href={item.href} aria-current={item.key === currentTopKey ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>

    <details class="mobile-menu" data-mobile-menu>
      <summary aria-label="Navigation menu"><span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span></summary>
      <div class="mobile-menu-panel">
        <nav aria-label="Mobile primary navigation">
          <details class:list={["mobile-provider-disclosure", { "is-current-section": currentTopKey === "providers" }]} data-mobile-provider-menu>
            <summary aria-label={currentTopKey === "providers" ? "Fundraising Providers, current section" : undefined}>Fundraising Providers <span aria-hidden="true">⌄</span></summary>
            <div class="mobile-provider-links">
              <a href={SITE_ROUTES.directory} aria-current={providerParentIsPage ? "page" : undefined}>All Fundraising Providers</a>
              <p>By organization</p>
              {PROVIDER_ORGANIZATION_NAVIGATION.map((item) => (
                <a href={item.href} aria-current={item.key === currentProviderChildKey ? "page" : undefined} data-nav-group={item.group}>{item.label}</a>
              ))}
              <p>By fundraising method</p>
              {PROVIDER_METHOD_NAVIGATION.map((item) => (
                <a href={item.href} aria-current={item.key === currentProviderChildKey ? "page" : undefined} data-nav-method={item.method}>{item.label}</a>
              ))}
            </div>
          </details>
          <div class="mobile-top-links">
            {PRIMARY_NAVIGATION.map((item) => (
              <a href={item.href} aria-current={item.key === currentTopKey ? "page" : undefined}>{item.label}<span aria-hidden="true">→</span></a>
            ))}
          </div>
        </nav>
      </div>
    </details>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const providerMenu = document.querySelector<HTMLElement>("[data-provider-menu]");
  const providerToggle = document.querySelector<HTMLButtonElement>("[data-provider-menu-toggle]");
  const providerPanel = document.querySelector<HTMLElement>("[data-provider-menu-panel]");
  const mobileMenu = document.querySelector<HTMLDetailsElement>("[data-mobile-menu]");
  const mobileProviderMenu = document.querySelector<HTMLDetailsElement>("[data-mobile-provider-menu]");
  let closeTimer: number | undefined;
  let scrollFrame = 0;
  let menuPinned = false;

  if (window.location.pathname === "/providers/") {
    const params = new URLSearchParams(window.location.search);
    const group = params.get("group");
    const methods = params.getAll("method");
    const activeMethod = methods.find((method) => document.querySelector(`[data-nav-method="${CSS.escape(method)}"]`));
    const childLinks = group
      ? Array.from(document.querySelectorAll<HTMLElement>(`[data-nav-group="${CSS.escape(group)}"]`))
      : Array.from(document.querySelectorAll<HTMLElement>("[data-nav-method]"))
          .filter((link) => link.dataset.navMethod === activeMethod);

    if (childLinks.length > 0) {
      document.querySelectorAll<HTMLElement>(".provider-parent-link[aria-current], .mobile-provider-links [aria-current]")
        .forEach((link) => link.removeAttribute("aria-current"));
      childLinks.forEach((link) => link.setAttribute("aria-current", "page"));
      providerMenu?.classList.add("is-current-section");
      mobileProviderMenu?.classList.add("is-current-section");
      document.querySelector(".provider-parent-link")?.setAttribute("aria-label", "Fundraising Providers, current section");
    }
  }

  const openProviderMenu = () => {
    if (!providerMenu || !providerToggle || !providerPanel) return;
    window.clearTimeout(closeTimer);
    providerPanel.hidden = false;
    providerMenu.classList.add("is-open");
    providerToggle.setAttribute("aria-expanded", "true");
    providerToggle.setAttribute("aria-label", "Close Fundraising Providers menu");
  };

  const closeProviderMenu = (returnFocus = false) => {
    if (!providerMenu || !providerToggle || !providerPanel) return;
    window.clearTimeout(closeTimer);
    providerPanel.hidden = true;
    providerMenu.classList.remove("is-open");
    providerToggle.setAttribute("aria-expanded", "false");
    providerToggle.setAttribute("aria-label", "Open Fundraising Providers menu");
    menuPinned = false;
    if (returnFocus) providerToggle.focus();
  };

  const scheduleProviderClose = () => {
    window.clearTimeout(closeTimer);
    closeTimer = window.setTimeout(() => closeProviderMenu(), 180);
  };

  providerMenu?.addEventListener("pointerenter", openProviderMenu);
  providerMenu?.addEventListener("pointerleave", scheduleProviderClose);
  providerMenu?.addEventListener("focusout", (event) => {
    if (!providerMenu.contains(event.relatedTarget as Node | null)) scheduleProviderClose();
  });
  providerToggle?.addEventListener("click", () => {
    if (providerPanel?.hidden) {
      openProviderMenu();
      menuPinned = true;
    } else if (!menuPinned) {
      menuPinned = true;
    } else {
      closeProviderMenu();
    }
  });

  document.addEventListener("pointerdown", (event) => {
    const target = event.target as Node;
    if (providerMenu && !providerMenu.contains(target)) closeProviderMenu();
    if (mobileMenu?.open && !mobileMenu.contains(target)) {
      mobileMenu.removeAttribute("open");
      mobileProviderMenu?.removeAttribute("open");
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    if (providerPanel && !providerPanel.hidden) {
      event.preventDefault();
      closeProviderMenu(true);
      return;
    }
    if (mobileProviderMenu?.open) {
      mobileProviderMenu.removeAttribute("open");
      mobileProviderMenu.querySelector("summary")?.focus();
      return;
    }
    if (mobileMenu?.open) {
      mobileMenu.removeAttribute("open");
      mobileProviderMenu?.removeAttribute("open");
      mobileMenu.querySelector(":scope > summary")?.focus();
    }
  });

  document.querySelectorAll(".site-header a").forEach((link) => {
    link.addEventListener("click", () => {
      closeProviderMenu();
      mobileMenu?.removeAttribute("open");
      mobileProviderMenu?.removeAttribute("open");
    });
  });

  const updateScrolledHeader = () => {
    scrollFrame = 0;
    header?.classList.toggle("is-scrolled", window.scrollY > 72);
  };
  const requestHeaderUpdate = () => {
    if (!scrollFrame) scrollFrame = window.requestAnimationFrame(updateScrolledHeader);
  };
  updateScrolledHeader();
  window.addEventListener("scroll", requestHeaderUpdate, { passive: true });
</script>
