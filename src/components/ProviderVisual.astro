---
import type { FundraisingVisual } from "../data/visuals";

interface Props {
  providerName: string;
  visual: FundraisingVisual | null;
}

const { providerName, visual } = Astro.props;
const initials = providerName.split(/\s+/).map((part) => part[0]).join("").slice(0, 2);
const isRepresentative = visual?.type === "representative-method";
---

<figure class:list={["provider-visual", { "provider-visual-fallback": !visual }]}>
  {
    visual ? (
      <>
        <div class="provider-visual-image">
          <img src={visual.src} alt={visual.alt} width="900" height="700" loading="eager" />
        </div>
        {isRepresentative && (
          <span class="representative-marker" tabindex="0" aria-label="Representative fundraising image">
            <span aria-hidden="true">i</span>
            <span class="representative-tooltip" role="tooltip">Representative fundraising image</span>
          </span>
        )}
      </>
    ) : (
      <div class="provider-identity-art" aria-hidden="true">
        <strong>{initials}</strong>
        <small>Provider profile</small>
      </div>
    )
  }
  {!visual && <figcaption>Independent research profile for {providerName}.</figcaption>}
</figure>

<style>
  .provider-visual { position: relative; margin: 0; align-self: center; }
  .provider-visual:not(.provider-visual-fallback) { width: calc(100% + 3rem); margin-inline: -1.5rem; }
  .provider-visual-image { position: relative; overflow: hidden; aspect-ratio: .96; border-radius: 43% 57% 31% 69% / 27% 34% 66% 73%; }
  .provider-visual-image::after { content: ""; position: absolute; inset: 0; background: linear-gradient(130deg, rgba(10,34,55,.24), transparent 52%, rgba(105,68,173,.12)); }
  .representative-marker { position: absolute; top: 14%; right: 14%; z-index: 3; display: grid; width: 2rem; height: 2rem; place-items: center; border: 1px solid rgba(255,255,255,.7); border-radius: .5rem; background: rgba(10,34,55,.88); color: #fff; font-size: .78rem; font-weight: 700; font-style: normal; cursor: help; }
  .representative-tooltip { position: absolute; top: calc(100% + .5625rem); right: 0; width: max-content; max-width: 13.125rem; padding: .4375rem .5625rem; border-radius: .4375rem; background: var(--ink-deep); color: #fff; font-size: .68rem; font-weight: 500; line-height: 1.3; opacity: 0; pointer-events: none; transform: translateY(-.1875rem); transition: opacity 120ms ease, transform 120ms ease; }
  .representative-marker:hover .representative-tooltip, .representative-marker:focus .representative-tooltip { opacity: 1; transform: none; }
  img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  figcaption { max-width: 21.25rem; margin: .8125rem auto 0; color: var(--text-muted); font-size: .72rem; line-height: 1.45; text-align: center; }
  .provider-identity-art { position: relative; display: grid; min-height: 17.5rem; place-content: center; overflow: hidden; border-radius: 1.75rem .75rem 2.75rem 1rem; background: linear-gradient(145deg, var(--ink-deep) 0%, var(--ink-teal) 58%, #285c70 100%); box-shadow: 0 1.5rem 3.25rem rgba(10,34,55,.22); color: #fff; text-align: center; }
  .provider-identity-art::before { content: ""; position: absolute; inset: -18% -30% 52% 8%; background: linear-gradient(115deg, rgba(8,127,120,.54), rgba(34,111,193,.08)); clip-path: polygon(0 12%, 100% 0, 85% 100%, 9% 78%); }
  .provider-identity-art::after { content: ""; position: absolute; inset: 58% -14% -24% -24%; background: linear-gradient(120deg, rgba(105,68,173,.4), rgba(18,48,74,.08)); clip-path: polygon(0 25%, 88% 0, 100% 76%, 17% 100%); }
  strong, small { position: relative; z-index: 1; }
  strong { font-size: clamp(3.8rem, 8vw, 6.4rem); line-height: .8; letter-spacing: -.08em; }
  small { margin-top: .9375rem; color: var(--teal-bright); font-size: .68rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  @media (max-width: 780px) {
    .provider-visual,
    .provider-visual:not(.provider-visual-fallback) { width: min(24rem, 100%); margin-inline: 0; justify-self: center; }
    .provider-visual-image { aspect-ratio: 1.08; }
  }
  @media (prefers-reduced-motion: reduce) { .representative-tooltip { transform: none; transition: none; } }
</style>
