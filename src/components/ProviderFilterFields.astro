---
import { GROUP_OPTIONS, METHOD_OPTIONS } from "../data/semanticTaxonomy";

---

<fieldset data-group-fieldset>
  <legend>Group type</legend>
  <label><input type="radio" name="group" value="" /> <span>All group types</span></label>
  {GROUP_OPTIONS.map((option) => <label class={`semantic-${option.tone}`}><input type="radio" name="group" value={option.value} /> <span>{option.label}</span></label>)}
  <label><input type="radio" name="group" value="other" /> <span>Any other group type</span></label>
</fieldset>

<fieldset>
  <legend>Fundraising methods</legend>
  {METHOD_OPTIONS.map((option) => <label class={`semantic-${option.tone}`}><input type="checkbox" name="method" value={option.value} /> <span>{option.label}</span></label>)}
</fieldset>
