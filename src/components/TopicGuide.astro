---
import { getEntry, render, type CollectionEntry } from "astro:content";
import { legacyRoutes } from "../data/legacyRoutes";
import { providerProfilePath } from "../data/providerLinks";
import { SITE_ROUTES } from "../data/site";
import { topicPath } from "../data/topics";
import TopicLinkList from "./TopicLinkList.astro";
import RelatedTopics from "./RelatedTopics.astro";

interface Props { topic: CollectionEntry<"topics"> }
const { topic } = Astro.props;
const { Content } = await render(topic);
const recommendations = await Promise.all(topic.data.providers.map(async (recommendation) => {
  const provider = await getEntry(recommendation.provider);
  if (!provider || provider.data.meta.deleted || provider.data.status.lifecycle !== "active") throw new Error(`Topic ${topic.id} references an unavailable provider`);
  return { ...recommendation, provider };
}));
const groups = [
  { relationship: "direct", title: "Providers for this approach", intro: "These records cover a format or audience discussed in this guide. Check the program, eligibility, and current terms directly with the provider." },
  { relationship: "alternative", title: "Other approaches to consider", intro: "These are related alternatives, not additional suppliers of the exact product or format described above." },
].map((group) => ({ ...group, entries: recommendations.filter((entry) => entry.relationship === group.relationship) })).filter((group) => group.entries.length > 0);
const related = topic.data.related.map((path) => legacyRoutes.find((route) => route.path === path)!);
---
<article class="topic-guide">
  <p class="topic-updated">Updated <time datetime={topic.data.updated}>{new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" }).format(new Date(topic.data.updated))}</time></p>
  <div class="topic-copy" data-topic-copy><Content /></div>
  {groups.map((group) => (
    <section class="provider-options" data-provider-relationship={group.relationship} aria-label={group.title}>
      <h2>{group.title}</h2><p>{group.intro}</p>
      <TopicLinkList links={group.entries.map(({ provider, note }) => ({ title: provider.data.identity.name, href: providerProfilePath(provider.data.identity.slug), description: [provider.data.content.summary, note].filter(Boolean).join(" ") }))} />
    </section>
  ))}
  <RelatedTopics items={[...related.map((route) => ({ title: route.title, href: topicPath(route.path) })), { title: "All fundraising ideas by category", href: SITE_ROUTES.ideas }]} />
</article>
<style lang="scss">
  .topic-guide { max-width: 960px; margin: 36px auto 0; }
  .topic-updated { color: var(--text-muted); font-size: .85rem; }
  .topic-copy {
    max-width: 74ch;
    :global(h2) { margin: 36px 0 16px; color: var(--ink); font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.2; letter-spacing: -.025em; }
    :global(p) { margin: 0 0 18px; color: var(--text-muted); line-height: 1.8; }
  }
  .provider-options {
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
    h2 { margin: 0 0 16px; color: var(--ink); font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.2; letter-spacing: -.025em; }
    > p { max-width: 74ch; color: var(--text-muted); line-height: 1.8; }
  }
</style>
