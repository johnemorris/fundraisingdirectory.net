---
import { finderGroups, finderInterests } from "../../data/homepage";
import { SITE_ROUTES } from "../../data/site";
import { semanticToneClass } from "../../data/semanticTaxonomy";
---

<section class="hero-section" id="finder" aria-labelledby="hero-title">
  <div class="hero-orbit hero-orbit-one" aria-hidden="true"></div>
  <div class="hero-orbit hero-orbit-two" aria-hidden="true"></div>

  <div class="hero-grid shell-wide">
    <div class="hero-copy">
      <p class="eyebrow eyebrow-light">Fundraising starts with options</p>
      <h1 id="hero-title">Find a fundraiser that <em>fits your group.</em></h1>
      <p class="hero-intro">
        Explore fundraising ideas, programs, and providers without spending hours figuring out what is available.
      </p>

      <form class="finder-panel" action={SITE_ROUTES.directory} method="get">
        <div class="finder-heading">
          <div>
            <span class="finder-kicker">Fundraiser Finder</span>
            <h2>Start with two quick questions.</h2>
          </div>
          <span class="finder-time">About 30 seconds</span>
        </div>

        <fieldset class="finder-question">
          <legend><span>1</span> Who are you fundraising for?</legend>
          <div class="finder-options finder-groups">
            {finderGroups.map((group, index) => (
              <label class:list={["finder-choice", semanticToneClass("group", group.value)]}>
                <input type="radio" name="group" value={group.value} required checked={index === 0} />
                <span>{group.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="finder-question">
          <legend><span>2</span> What sounds interesting?</legend>
          <p class="finder-help">Choose as many as you like, or jump straight to ideas.</p>
          <div class="finder-options finder-interests">
            {finderInterests.map((interest) => (
              <label class:list={["finder-choice", "finder-choice-icon", semanticToneClass("method", interest.value)]}>
                <input type="checkbox" name="method" value={interest.value} />
                <span class="choice-icon" data-icon={interest.icon} aria-hidden="true"></span>
                <span>{interest.label}</span>
              </label>
            ))}
            <a
              class="finder-choice finder-choice-icon finder-escape"
              href={SITE_ROUTES.ideas}
            >
              <span class="choice-icon" data-icon="spark" aria-hidden="true"></span>
              <span>Not Sure — Show Me Ideas</span>
            </a>
          </div>
        </fieldset>

        <div class="finder-actions">
          <button class="button button-primary button-large" type="submit">
            Find Fundraisers <span aria-hidden="true">→</span>
          </button>
          <a class="finder-search-link" href={SITE_ROUTES.directory}>
            Already know what you're looking for? <span>Search fundraisers →</span>
          </a>
        </div>
      </form>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="hero-image-wrap">
        <img
          src="/images/home/fundraising-community-hero.jpg"
          alt=""
          width="1600"
          height="727"
          fetchpriority="high"
        />
      </div>
      <div class="hero-note hero-note-top"><span>07</span> ways to begin</div>
      <div class="hero-note hero-note-bottom">
        <strong>Made for real groups</strong>
        <span>Schools · teams · causes · communities</span>
      </div>
    </div>
  </div>
</section>
