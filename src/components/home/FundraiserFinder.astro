---
import { finderGroups, finderInterests } from "../../data/homepage";
import { SITE_ROUTES } from "../../data/site";
---

<section class="hero-section" id="finder" aria-labelledby="hero-title">
  <div class="hero-orbit hero-orbit-one" aria-hidden="true"></div>
  <div class="hero-orbit hero-orbit-two" aria-hidden="true"></div>

  <div class="hero-grid shell-wide">
    <div class="hero-copy">
      <p class="eyebrow eyebrow-light">Fundraising starts with options</p>
      <h1 id="hero-title">Find a fundraiser that <em>fits your group.</em></h1>
      <p class="hero-intro">
        Explore fundraising ideas, programs, and providers without spending hours figuring out what is available.
      </p>

      <form class="finder-panel" action={SITE_ROUTES.directory} method="get">
        <div class="finder-heading">
          <div>
            <span class="finder-kicker">Fundraiser Finder</span>
            <h2>Start with two quick questions.</h2>
          </div>
          <span class="finder-time">About 30 seconds</span>
        </div>

        <fieldset class="finder-question">
          <legend>Who are you fundraising for?</legend>
          <select class="finder-select" name="group" aria-label="Choose a fundraising group">
            <option value="">Any group</option>
            {finderGroups.map((group) => <option value={group.value}>{group.label}</option>)}
          </select>
        </fieldset>

        <fieldset class="finder-question">
          <legend>What sounds interesting?</legend>
          <details class="finder-multiselect">
            <summary>
              <span data-method-summary>Any approach</span>
              <span class="finder-chevron" aria-hidden="true"></span>
            </summary>
            <div class="finder-method-options">
              {finderInterests.map((interest) => (
                <label>
                  <input type="checkbox" name="method" value={interest.value} data-label={interest.label} />
                  <span>{interest.label}</span>
                </label>
              ))}
            </div>
          </details>
        </fieldset>

        <div class="finder-actions">
          <button class="button button-primary button-large" type="submit">
            Find Fundraisers <span aria-hidden="true">→</span>
          </button>
        </div>
      </form>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="hero-image-wrap">
        <img
          src="/images/home/fundraising-community-hero.jpg"
          alt=""
          width="1600"
          height="727"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<script>
  const controls = document.querySelectorAll<HTMLDetailsElement>(".finder-multiselect");

  controls.forEach((control) => {
    const summary = control.querySelector<HTMLElement>("summary");
    const summaryText = control.querySelector<HTMLElement>("[data-method-summary]");
    const options = Array.from(control.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'));

    const updateSummary = () => {
      if (!summaryText) return;
      const selected = options.filter((option) => option.checked);
      const labels = selected.map((option) => option.dataset.label ?? option.value);
      summaryText.textContent = labels.length === 0
        ? "Any approach"
        : labels.length <= 2
          ? labels.join(" + ")
          : `${labels.length} approaches selected`;
    };

    options.forEach((option) => option.addEventListener("change", updateSummary));
    control.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && control.open) {
        control.open = false;
        summary?.focus();
      }
    });
    updateSummary();
  });

  document.addEventListener("click", (event) => {
    controls.forEach((control) => {
      if (control.open && !control.contains(event.target as Node)) control.open = false;
    });
  });

  document.querySelectorAll<HTMLFormElement>(".finder-panel").forEach((form) => {
    const group = form.querySelector<HTMLSelectElement>('select[name="group"]');
    const methods = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="method"]'));
    form.addEventListener("submit", (event) => {
      if (!group?.value && !methods.some((method) => method.checked)) {
        event.preventDefault();
        window.location.assign(form.action);
        return;
      }
      if (group && !group.value) group.disabled = true;
    });
    window.addEventListener("pageshow", () => {
      if (group) group.disabled = false;
    });
  });
</script>
