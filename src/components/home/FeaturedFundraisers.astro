---
import type { CollectionEntry } from "astro:content";
import ProviderVisual from "../ProviderVisual.astro";
import type { PlacementType } from "../../data/homepage";
import { formatProviderLabel } from "../../data/providerLabels";
import { providerProfilePath } from "../../data/providerLinks";
import { getProviderVisual } from "../../data/visuals";

interface Props {
  provider: CollectionEntry<"providers">;
}

const { provider } = Astro.props;
const { identity, content, programs, geography, editorial, affiliation } = provider.data;

const placement: PlacementType = affiliation.type === "sponsor"
  ? "sponsored"
  : editorial.featured
    ? "featured"
    : "organic";

const placementLabel = placement === "organic" ? null : placement === "featured" ? "Featured" : "Sponsored";
const providerHref = providerProfilePath(identity.slug);
const visual = getProviderVisual(identity.slug);
const methods = [...new Set(programs.map((program) => formatProviderLabel(program.method)))];

---

<section class="section featured-section" aria-labelledby="featured-title">
  <div class="shell-wide featured-provider-layout">
    <div class="featured-provider-visual">
      <ProviderVisual providerName={identity.name} visual={visual} />
    </div>

    <div class="featured-provider-copy">
      <div class="featured-provider-topline">
        <p class="eyebrow eyebrow-light">Featured provider</p>
        {placementLabel && <span class:list={["placement-badge", `placement-${placement}`]}>{placementLabel}</span>}
      </div>
      <h2 id="featured-title">{identity.name}</h2>
      <p class="featured-provider-summary">{content.summary}</p>
      <dl class="featured-provider-facts">
        <div>
          <dt>Programs documented</dt>
          <dd>{programs.length}</dd>
        </div>
        <div>
          <dt>Availability</dt>
          <dd>{geography.scope.map(formatProviderLabel).join(" · ")}</dd>
        </div>
        <div>
          <dt>Fundraising approaches</dt>
          <dd>{methods.join(" · ")}</dd>
        </div>
      </dl>
      <a class="button button-light" href={providerHref}>Explore {identity.name} <span aria-hidden="true">→</span></a>
      <p class="placement-note">
        Paid placements are always labeled <strong>Sponsored</strong>. A <strong>Featured</strong> label identifies special visibility, not an endorsement.
      </p>
    </div>
  </div>
</section>
