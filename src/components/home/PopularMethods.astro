---
import { popularMethods } from "../../data/homepage";
import { SITE_ROUTES } from "../../data/site";

const visualMethods = popularMethods.filter((method) => "image" in method);
const compactMethods = popularMethods.filter((method) => !("image" in method));
---

<section class="section popular-section" id="popular-methods" aria-labelledby="popular-title">
  <div class="shell-wide">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">Explore by approach</p>
        <h2 id="popular-title">Popular ways to fundraise</h2>
      </div>
      <a class="text-link" href={SITE_ROUTES.directory}>Browse all methods <span aria-hidden="true">→</span></a>
    </div>

    <div class="popular-layout">
      <div class="popular-visuals">
        {visualMethods.map((method, index) => (
          <a class:list={["method-visual", `method-visual-${index + 1}`]} href={method.href}>
            <img src={method.image} alt={method.imageAlt} width="960" height="640" loading="lazy" />
            <strong>{method.title}</strong>
            <span class="method-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>

      <div class="method-list" aria-label="More popular fundraising methods">
        {compactMethods.map((method) => (
          <a href={method.href}>
            <strong>{method.title}</strong>
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
