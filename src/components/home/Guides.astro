---
import { guides } from "../../data/homepage";
import { SITE_ROUTES } from "../../data/site";

const featuredGuide = guides.find((guide) => guide.featured);
const supportingGuides = guides.filter((guide) => !guide.featured);
---

<section class="section guides-section" aria-labelledby="guides-title">
  <div class="shell-wide">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">Useful right now</p>
        <h2 id="guides-title">A little clarity goes a long way.</h2>
      </div>
      <a class="text-link" href={SITE_ROUTES.guides}>All guides <span aria-hidden="true">→</span></a>
    </div>

    <div class="guides-layout">
      {featuredGuide && (
        <a class="featured-guide" href={featuredGuide.href}>
          <div class="guide-art" aria-hidden="true">
            <span class="guide-paper guide-paper-one"></span>
            <span class="guide-paper guide-paper-two"></span>
            <span class="guide-check">✓</span>
          </div>
          <div>
            <span class="guide-label">{featuredGuide.label}</span>
            <h3>{featuredGuide.title}</h3>
            <p>{featuredGuide.description}</p>
            <strong>Read the guide <span aria-hidden="true">→</span></strong>
          </div>
        </a>
      )}

      <div class="guide-links">
        {supportingGuides.map((guide, index) => (
          <a href={guide.href}>
            <span class="guide-number">0{index + 1}</span>
            <span><small>{guide.label}</small><strong>{guide.title}</strong></span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

