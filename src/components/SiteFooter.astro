---
import Brand from "./Brand.astro";
import { SITE_ROUTES } from "../data/site";

const columns = [
  {
    title: "Find Fundraisers",
    links: [
      ["Browse Directory", SITE_ROUTES.directory],
      ["Schools", SITE_ROUTES.schools],
      ["Sports Teams", SITE_ROUTES.sports],
      ["Churches", SITE_ROUTES.churches],
      ["Nonprofits", SITE_ROUTES.nonprofits],
    ],
  },
  {
    title: "Explore",
    links: [
      ["Fundraising Ideas", SITE_ROUTES.ideas],
      ["Popular Fundraisers", "/#popular-methods"],
      ["Latest Guides", SITE_ROUTES.guides],
    ],
  },
  {
    title: "Providers",
    links: [
      ["Provider listings — Coming soon", null],
    ],
  },
  {
    title: "About",
    links: [
      ["About", SITE_ROUTES.about],
      ["Contact", SITE_ROUTES.contact],
      ["Privacy", SITE_ROUTES.privacy],
      ["Disclaimer", SITE_ROUTES.disclaimer],
    ],
  },
] as const;
---

<footer class="site-footer">
  <div class="footer-inner shell-wide">
    <div class="footer-intro">
      <Brand />
      <p>
        A clearer way to discover fundraising ideas, programs, and providers for your group.
      </p>
    </div>

    <div class="footer-navigation">
      {columns.map((column) => (
        <div class="footer-column">
          <h2>{column.title}</h2>
          {column.links.map(([label, href]) =>
            href ? <a href={href}>{label}</a> : <span>{label}</span>
          )}
        </div>
      ))}
    </div>

    <p class="footer-disclaimer">
      FundraisingDirectory.net is an independent information and discovery
      resource. A listing is not an endorsement, sponsorship, or guarantee.
      {" "}
      <a href={SITE_ROUTES.disclaimer}>Read the full directory disclaimer.</a>
    </p>

    <p class="footer-image-disclosure">
      <span aria-hidden="true">ⓘ</span>
      <span>Representative imagery: Some images illustrate fundraising activities and may not depict the provider shown.</span>
    </p>

    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} FundraisingDirectory.net</span>
      <span>Independent fundraising discovery and information.</span>
    </div>
  </div>
</footer>
