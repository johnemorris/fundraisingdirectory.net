<section class="profit-calculator" aria-labelledby="profit-calculator-title">
  <h2 id="profit-calculator-title">Estimate candy-sale cash proceeds</h2>
  <p>Illustrative inputs, not provider prices or a forecast. Enter your written quote. Inventory costs include every item purchased, even items you do not sell. Add shipping, payment fees and supplies to other costs.</p>
  <form data-profit-calculator>
    <label>Items purchased <input name="purchased" type="number" min="0" step="1" value="200" required /></label>
    <label>Items sold <input name="sold" type="number" min="0" step="1" value="150" required /></label>
    <label>Cost per item (USD) <input name="unitCost" type="number" min="0" step="0.01" value="1" required /></label>
    <label>Sale price per item (USD) <input name="salePrice" type="number" min="0" step="0.01" value="2" required /></label>
    <label>Other costs (USD) <input name="otherCosts" type="number" min="0" step="0.01" value="0" required /></label>
    <button class="button button-primary">Calculate proceeds</button>
  </form>
  <p role="status" data-profit-result>With these illustrative inputs: $300 revenue − $200 costs = $100 cash proceeds, with 50 unsold items.</p>
  <noscript><p>Formula: items sold × sale price − (items purchased × unit cost) − other costs. Unsold stock is not cash proceeds.</p></noscript>
</section>
<script>
  import { inventoryFundraiserResult } from "../lib/fundraisingMath";
  const form = document.querySelector<HTMLFormElement>("[data-profit-calculator]");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const result = inventoryFundraiserResult(...["purchased", "sold", "unitCost", "salePrice", "otherCosts"].map((name) => Number(data.get(name))) as [number, number, number, number, number]);
    const currency = (value: number) => new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" }).format(value);
    document.querySelector("[data-profit-result]")!.textContent = result ? `${currency(result.revenue)} revenue − ${currency(result.costs)} costs = ${currency(result.net)} cash proceeds; ${result.unsold} unsold items.` : "Use non-negative numbers and whole item counts. Items sold cannot exceed items purchased.";
  });
</script>
<style lang="scss">
  .profit-calculator { padding-block: 1.5rem; border-block: 1px solid var(--border); }
  p { line-height: 1.75; }
  form { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: 1rem; align-items: end; }
  label { display: grid; gap: .5rem; }
  input { min-width: 0; width: 100%; padding: .75rem; min-height: 2.75rem; border: 1px solid var(--border); border-radius: .5rem; font: inherit; }
</style>
