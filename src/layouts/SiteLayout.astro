---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SITE_ROUTES } from "../data/site";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  canonical?: string;
  socialImage?: string | false;
  bodyClass?: string;
}

const {
  title,
  description = "Find and compare fundraising providers, programs, and fundraising options.",
  noindex = false,
  canonical = new URL(Astro.url.pathname, SITE_ROUTES.origin).href,
  socialImage = `${SITE_ROUTES.origin}/og.png`,
  bodyClass,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#12304a" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FundraisingDirectory.net" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {
      socialImage && (
        <>
          <meta property="og:image" content={socialImage} />
          <meta property="og:image:width" content="1735" />
          <meta property="og:image:height" content="907" />
          <meta
            property="og:image:alt"
            content="FundraisingDirectory.net — Find fundraising ideas and providers"
          />
        </>
      )
    }
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
  </head>

  <body class={bodyClass}>
    <SiteHeader />

    <slot />
    <SiteFooter />
  </body>
</html>
